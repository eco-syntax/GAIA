# GAIA container configuration — copy to .env and fill in.
# One chat platform is enough; delete the lines you don't use.

# Telegram (get a token from @BotFather, then message the bot once and put the
# chat id the bot prints at startup into GAIA_ALLOWED_CHAT_IDS):
GAIA_TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-botfather
GAIA_ALLOWED_CHAT_IDS=123456789

# If you allow-list a GROUP chat (negative id), also list the user ids who may
# act there — everyone else in the group is ignored (fail closed):
# GAIA_ALLOWED_TELEGRAM_USER_IDS=111111111,222222222

# Slack (needs both tokens; ids are channel ids):
# GAIA_SLACK_BOT_TOKEN=xoxb-...
# GAIA_SLACK_APP_TOKEN=xapp-...
# GAIA_ALLOWED_SLACK_CHAT_IDS=C0123ABC

# Discord (token from the developer portal; ids are channel ids):
# GAIA_DISCORD_BOT_TOKEN=...
# GAIA_ALLOWED_DISCORD_CHAT_IDS=123456789

# Matrix (client-server API):
# GAIA_MATRIX_HOMESERVER=https://matrix.example.org
# GAIA_MATRIX_USER_ID=@gaia:example.org
# GAIA_MATRIX_ACCESS_TOKEN=...
# GAIA_ALLOWED_MATRIX_ROOM_IDS=!room:example.org

# Model: "provider/id". With the bundled llama.cpp service (compose profile "llama"),
# the provider is "llama.cpp" (with the dot) and the id is the model's filename
# without the .gguf extension, e.g.:
# GAIA_MODEL=llama.cpp/Qwen3.5-9B-Q4_K_M
# For other OpenAI-compatible endpoints use that provider's name, e.g.
# GAIA_MODEL=lmstudio/qwen3-8b with LLAMA_BASE_URL=http://host.docker.internal:1234
# With no model set, pick one in chat via /model.

# Only for the bundled llama.cpp service (Option A) — with it commented out,
# compose still defaults the gateway to http://llama:8080; uncomment here only
# if your model server lives somewhere else:
# LLAMA_BASE_URL=http://host.docker.internal:8080
